{
  "name": "indie-alternatives-mcp",
  "version": "0.2.0",
  "description": "Indie Alternatives: find indie-made tools and alternatives to big-name software from any AI assistant. Logs unmet needs anonymously. MCP (stdio + HTTP), REST/OpenAPI, function calling and CLI.",
  "type": "module",
  "bin": {
    "indie-alternatives-mcp": "dist/src/stdio.js",
    "indie-alternatives-http": "dist/src/http.js",
    "indie-alternatives": "dist/src/cli.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "dist/src",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "alternatives",
    "software-alternatives",
    "indie-hackers",
    "indie-makers",
    "saas-alternatives",
    "chatgpt",
    "claude",
    "openapi",
    "function-calling"
  ],
  "homepage": "https://indiealternatives.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuDao0123/indie-alternatives.git"
  },
  "bugs": {
    "url": "https://github.com/WuDao0123/indie-alternatives/issues"
  },
  "mcpName": "io.github.WuDao0123/indie-alternatives"
}
